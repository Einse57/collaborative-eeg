# Auto detect text files and perform LF normalization
* text=auto

# PowerShell scripts should use CRLF on Windows
*.ps1 text eol=crlf

# Shell scripts should use LF
*.sh text eol=lf

# Python files
*.py text eol=lf

# JavaScript/TypeScript files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.fif binary
